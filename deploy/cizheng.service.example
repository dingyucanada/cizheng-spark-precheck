[Unit]
Description=Cizheng one-page ceramic precheck
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_SPARK_USER
WorkingDirectory=/REPLACE_WITH_PROJECT_PATH/cizheng-spark-precheck
EnvironmentFile=/REPLACE_WITH_PROJECT_PATH/cizheng-spark-precheck/.env
ExecStart=/REPLACE_WITH_PROJECT_PATH/cizheng-spark-precheck/.venv/bin/python -m uvicorn cizheng_precheck.api:create_app --factory --host 127.0.0.1 --port 8790 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
