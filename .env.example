# Local visual endpoint, hosted on this Spark or through an SSH tunnel.
CZ_MODEL_BASE_URL=http://127.0.0.1:8000/v1
CZ_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
CZ_MODEL_KEY=
CZ_MODEL_TIMEOUT=85
CZ_JOB_TIMEOUT=260
CZ_DATA_DIR=./runtime
# Set to a random long value before sharing access beyond localhost.
CZ_ACCESS_TOKEN=
# Offline by default. User must also enable online retrieval for each case.
CZ_ENABLE_ONLINE=false
# Optional provider endpoint for TEXT ONLY review. Images are never sent here.
CZ_TEXT_BASE_URL=
CZ_TEXT_MODEL=
CZ_TEXT_KEY=
# Explicit global and per-case opt-in are both required for cloud text review.
CZ_ALLOW_CLOUD_TEXT=false
# Use installed CJK fonts on Linux; deployment script prepares these.
CZ_FONT_PATH=
CZ_FONT_BOLD_PATH=
